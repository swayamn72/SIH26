# MuleGuard Local configuration
# No secrets or API keys here — this app runs fully offline.

# Data directory (all user data stored here)
DATA_DIR=./data

# Ollama host (Docker service name or localhost for direct access)
OLLAMA_HOST=http://ollama:11434

# Log level (DEBUG, INFO, WARNING, ERROR)
LOG_LEVEL=INFO

# Bind address (127.0.0.1 for local-only, 0.0.0.0 for LAN access)
HOST=127.0.0.1

# Port
PORT=8000
