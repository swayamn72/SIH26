# MuleGuard Local configuration

# Data directory (all user data stored here)
DATA_DIR=./data

# --- LLM Narrative Generation ---
# Option 1 (Recommended): Groq API — fast, free tier available
# Get your free key at: https://console.groq.com
GROQ_API_KEY=your_groq_api_key_here

# Option 2 (Offline): Local Ollama — set this if you want to run fully offline
# Leave GROQ_API_KEY empty and set OLLAMA_HOST instead
# OLLAMA_HOST=http://localhost:11434

# Log level (DEBUG, INFO, WARNING, ERROR)
LOG_LEVEL=INFO

# Bind address (127.0.0.1 for local-only, 0.0.0.0 for LAN access)
HOST=127.0.0.1

# Port
PORT=8000
